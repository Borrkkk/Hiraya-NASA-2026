# Copy to .env (setup.cmd does this automatically).
# The key stays on this machine and is never committed.
OPENAI_API_KEY=
PULSR_AI_MODEL=gpt-4.1-mini

# Leave blank to automatically find the newest installed index.
SPHEREX_INDEX_DIR=
SPHEREX_IMAGE_SOURCE=s3

# Relative paths are resolved from the backend folder.
PULSR_COMMUNITY_DB=.data/community.sqlite3
