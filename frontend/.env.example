# The deployed preview needs NO environment variables: it is a static, serverless
# app (docs/deploy.md). Everything below is only for local work on the real pipeline.

# Python backend for the real SPHEREx pipeline. When set, Next proxies /api/* to it.
# BACKEND_URL=http://localhost:8000

# With the backend running, use it for Explore instead of the prefetched demo data:
# NEXT_PUBLIC_EXPLORE_API=http
