# Base URL of the Python backend. Next proxies /api/* to it (see next.config.ts)
# and server code calls it directly.
BACKEND_URL=http://localhost:8000

# Explore page data source. "mock" (default) generates fake SPHEREx frames in the
# browser. "http" calls the Python API. See docs/explore-backend-integration.md.
NEXT_PUBLIC_EXPLORE_API=mock
